APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Google OAuth (isi sesuai OAuth Client di Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/masuk/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=katalog
# DB_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SSLMODE=require

# Database 2 - transaksi
# DB2_HOST=127.0.0.1
# DB2_PORT=5432
# DB2_DATABASE=medanvisit_transaksi
# DB2_USERNAME=postgres
# DB2_PASSWORD=
# DB2_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
# DB2_SSLMODE=require

# Supabase Server API (HTTPS; database tetap PostgreSQL)
SUPABASE_DB1_URL=
SUPABASE_DB1_PUBLISHABLE_KEY=
SUPABASE_DB1_SECRET_KEY=
SUPABASE_DB1_JWKS_URL=
SUPABASE_DB2_URL=
SUPABASE_DB2_PUBLISHABLE_KEY=
SUPABASE_DB2_SECRET_KEY=
SUPABASE_DB2_JWKS_URL=
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_PROVIDER=metered
METERED_APP_NAME=medanvisit
METERED_TURN_URLS="turn:asia.relay.metered.ca:80,turn:asia.relay.metered.ca:80?transport=tcp,turn:asia.relay.metered.ca:443,turns:asia.relay.metered.ca:443?transport=tcp"
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=
# METERED_TURN_API_KEY is intentionally not used: credentials are supplied
# from the server environment, not fetched via an unverified API response.
METERED_TURN_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Database 3 SPARQL (AllegroGraph)
SPARQL_DRIVER=allegrograph
SPARQL_HOST=https://example.allegrograph.cloud
SPARQL_DATABASE=MedanVisit-DB3-Wisata
SPARQL_USERNAME=
SPARQL_PASSWORD=
SPARQL_ENDPOINT="${SPARQL_HOST}/repositories/${SPARQL_DATABASE}/sparql"
SPARQL_STATEMENTS_ENDPOINT="${SPARQL_HOST}/repositories/${SPARQL_DATABASE}/statements"
SPARQL_TIMEOUT=60

# Pembayaran tiket (Midtrans, dashboard: Settings > Access Keys). Kosongkan MIDTRANS_SERVER_KEY untuk mode simulasi.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
