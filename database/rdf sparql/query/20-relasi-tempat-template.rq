# Template query SparqlService::relasiTempat().
# Ganti {{IRI_TEMPAT}} dan {{BATAS}} sebelum dijalankan.
PREFIX mv: <https://medanvisit.neoverse.my.id/ontologi#>
PREFIX schema: <https://schema.org/>

SELECT DISTINCT ?tujuan ?nama WHERE {
  <{{IRI_TEMPAT}}> (mv:dekatDengan|mv:beradaDi|mv:bagianDari|mv:berkaitanDengan) ?tujuan .
  ?tujuan schema:name ?nama .
}
ORDER BY LCASE(STR(?nama))
LIMIT {{BATAS}}
