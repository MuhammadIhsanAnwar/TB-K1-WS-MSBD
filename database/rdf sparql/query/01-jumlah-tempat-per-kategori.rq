# Jumlah tempat per kategori menggunakan tipe eksplisit yang ada pada data MedanVisit.
PREFIX mv: <https://medanvisit.neoverse.my.id/ontologi#>
PREFIX schema: <https://schema.org/>

SELECT ?kategori (COUNT(?tempat) AS ?jumlah) WHERE {
  VALUES (?kelas ?kategori) {
    (mv:SitusSejarah "Situs Sejarah")
    (mv:Museum "Museum")
    (mv:RumahIbadah "Rumah Ibadah")
    (mv:TempatKuliner "Tempat Kuliner")
    (mv:RuangPublik "Ruang Publik")
    (mv:PusatBelanja "Pusat Belanja")
    (mv:RekreasiAir "Rekreasi Air")
  }
  ?tempat a ?kelas ; schema:name ?nama .
}
GROUP BY ?kategori
ORDER BY DESC(?jumlah) ?kategori
