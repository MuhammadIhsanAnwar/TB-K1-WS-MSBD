res:tjong-a-fie-mansion a mv:SitusSejarah ;
    rdfs:label "Tjong A Fie Mansion"@id ;
    dcterms:source <https://medantourism.medan.go.id/destinasi_wisata/public/detail/4>,
        <https://museumtjongafie.com/en/visit-us/> ;
    owl:sameAs wd:Q7810631 ;
    geo1:lat 3.58543 ;
    geo1:long 98.68037 ;
    mv:beradaDi res:kec-medan-barat ;
    mv:caraMenuju "Becak motor dari Istana Maimun, 10 menit"@id,
        "Jalan kaki dari Lapangan Merdeka, 8 menit"@id ;
    mv:cerita """Tjong A Fie adalah saudagar Hakka yang datang ke Deli pada masa kejayaan tembakau dan menjadi pemimpin komunitas Tionghoa Medan. Rumahnya di Kesawan selesai dibangun 1900.

Arsitekturnya memadukan rumah Tionghoa, Eropa, dan Melayu. Kamar, perabot, dan foto keluarga masih tersimpan, sehingga pengunjung bisa melihat bagaimana sebuah keluarga saudagar hidup di Medan awal abad ke-20."""@id ;
    mv:dibangunOleh res:tjong-a-fie ;
    mv:durasiSinggah 60 ;
    mv:fasilitas "Kafe"@id,
        "Pemandu"@id,
        "Toilet"@id ;
    mv:hargaTiketMulai 35000 ;
    mv:jamBuka "09:00:00"^^xsd:time ;
    mv:jamTutup "17:00:00"^^xsd:time ;
    mv:kelurahan "Kesawan" ;
    mv:keteranganJam "Setiap hari, 09.00–17.00 (masuk terakhir 16.30), tutup saat Imlek" ;
    mv:radiusCheckin 80 ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "ID" ;
            schema:addressLocality "Medan" ;
            schema:addressRegion "Sumatera Utara" ;
            schema:streetAddress "Jl. Jend. Ahmad Yani No. 105" ] ;
    schema:description "Rumah saudagar Tjong A Fie di Kesawan, kini museum rumah."@id ;
    schema:image <https://medanvisit.neoverse.my.id/storage/foto_wisata/tjong-a-fie-mansion.jpg> ;
    schema:isAccessibleForFree false ;
    schema:name "Tjong A Fie Mansion"@id ;
    schema:offers [ a schema:Offer ;
            schema:name "Umum, termasuk pemandu"@id ;
            schema:price 35000 ;
            schema:priceCurrency "IDR" ] .

res:masjid-raya-al-mashun a mv:RumahIbadah ;
    rdfs:label "Masjid Raya Al-Mashun"@id ;
    dcterms:source <https://medantourism.medan.go.id/destinasi_wisata/public?utm_source=chatgpt.com> ;
    owl:sameAs wd:Q12497331 ;
    geo1:lat 3.57517 ;
    geo1:long 98.6873 ;
    mv:beradaDi res:kec-medan-kota ;
    mv:bergaya res:arsitektur-mughal ;
    mv:caraMenuju "Jalan kaki dari Istana Maimun, 6 menit"@id ;
    mv:cerita """Masjid Raya Al-Mashun dibangun oleh Sultan Ma'moen Al Rasyid, sultan yang sama yang membangun Istana Maimun, dan selesai pada 1909.

Denahnya segi delapan dengan kubah utama dikelilingi empat serambi. Masjid ini masih dipakai untuk salat berjamaah, jadi pengunjung datang di luar waktu salat dan berpakaian sopan."""@id ;
    mv:dibangunOleh res:sultan-maamun-al-rasyid ;
    mv:durasiSinggah 45 ;
    mv:fasilitas "Parkir"@id,
        "Peminjaman kain penutup"@id,
        "Tempat wudu"@id ;
    mv:jamBuka "04:00:00"^^xsd:time ;
    mv:jamTutup "00:00:00"^^xsd:time ;
    mv:kelurahan "Mesjid" ;
    mv:keteranganJam "Senin-Minggu, 04.00-00.00"@id ;
    mv:memilikiSejarah res:pembangunan-masjid-raya ;
    mv:radiusCheckin 100 ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "ID" ;
            schema:addressLocality "Medan" ;
            schema:addressRegion "Sumatera Utara" ;
            schema:streetAddress "Jl. Sisingamangaraja" ] ;
    schema:description "Masjid Kesultanan Deli, dibangun 1906–1909 dengan denah segi delapan."@id ;
    schema:image <https://medanvisit.neoverse.my.id/storage/foto_wisata/masjid-raya.jpg> ;
    schema:isAccessibleForFree true ;
    schema:name "Masjid Raya Al-Mashun"@id .

