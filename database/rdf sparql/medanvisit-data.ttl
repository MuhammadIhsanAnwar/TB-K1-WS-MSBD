res:istana-maimun a mv:SitusSejarah ;
    rdfs:label "Istana Maimun"@id ;
    dcterms:source <https://medantourism.medan.go.id/destinasi_wisata/public/detail/5>,
        <https://www.detik.com/sumut/berita/d-8239652/6-museum-di-medan-yang-wajib-dikunjungi> ;
    owl:sameAs wd:Q1674833 ;
    geo1:lat 3.57529 ;
    geo1:long 98.68405 ;
    mv:beradaDi res:kec-medan-maimun ;
    mv:bergaya res:arsitektur-mughal ;
    mv:caraMenuju "Becak motor dari Kesawan, tawar ongkos sebelum naik (Rp20.000–30.000)"@id,
        "Bus Listrik Medan koridor K1 melintas di depan istana"@id,
        "Jalan kaki dari Masjid Raya Al-Mashun, 6 menit"@id ;
    mv:cerita """Istana Maimun dibangun Sultan Ma'moen Al Rasyid Perkasa Alamsyah, sultan Deli kesembilan, dan rampung pada 1891. Bangunannya memadukan unsur Melayu, Islam, India, dan Eropa.

Warna kuning yang mendominasi istana adalah warna kebesaran Melayu. Sampai sekarang sebagian ruangan masih ditinggali kerabat kesultanan, dan pengunjung bisa berfoto memakai baju adat Melayu di balairung.

Di halaman istana ada bangunan kecil yang menyimpan Meriam Puntung, yang dalam cerita rakyat dikaitkan dengan legenda Putri Hijau."""@id ;
    mv:dekatDengan res:masjid-raya-al-mashun ;
    mv:dibangunOleh res:sultan-maamun-al-rasyid ;
    mv:dilayaniOleh res:becak-motor ;
    mv:durasiSinggah 60 ;
    mv:fasilitas "Balita di bawah 5 tahun gratis"@id,
        "Mushola"@id,
        "Parkir"@id,
        "Sewa baju adat Melayu (Rp20.000–50.000)"@id,
        "Toilet"@id ;
    mv:hargaTiketMulai 15000 ;
    mv:jamBuka "08:00:00"^^xsd:time ;
    mv:jamTutup "17:00:00"^^xsd:time ;
    mv:kelurahan "Aur" ;
    mv:keteranganJam "Senin-Minggu, 08.00-17.00"@id ;
    mv:memilikiSejarah res:pembangunan-istana-maimun ;
    mv:merepresentasikan res:melayu-deli ;
    mv:radiusCheckin 150 ;
    schema:address [ a schema:PostalAddress ;
            schema:addressCountry "ID" ;
            schema:addressLocality "Medan" ;
            schema:addressRegion "Sumatera Utara" ;
            schema:streetAddress "Jl. Brigjend Katamso No. 66" ] ;
    schema:description "Istana Kesultanan Deli, dibangun 1888–1891 oleh Sultan Ma'moen Al Rasyid."@id ;
    schema:image <https://medanvisit.neoverse.my.id/storage/foto_wisata/istana-maimun.jpg> ;
    schema:isAccessibleForFree false ;
    schema:name "Istana Maimun"@id ;
    schema:offers [ a schema:Offer ;
            schema:name "Umum"@id ;
            schema:price 15000 ;
            schema:priceCurrency "IDR" ] .

